# Copy this file to .env and fill in real values.
# Never commit the real .env file — it's already in .gitignore.

# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local example:  mongodb://127.0.0.1:27017/osama-portfolio
# Atlas example:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/osama-portfolio
MONGO_URI=mongodb://127.0.0.1:27017/osama-portfolio

# Frontend origin allowed to call this API (Vite dev server default shown)
# In production, set this to your real deployed frontend URL — if it's
# unset or wrong, the browser's CORS check will block your frontend
# rather than silently allowing every origin, so this must be correct.
CLIENT_URL=http://localhost:5173

# Auth
# REQUIRED — the server refuses to start without this (see server.js).
# Generate a strong random string for JWT_SECRET, e.g.: openssl rand -hex 32
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
